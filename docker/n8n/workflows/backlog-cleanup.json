        "jsCode": "// Mails for this run: not yet in processed_mails, LIMIT per mailbox (0 = all), none when COUNT_ONLY\nconst c = $('Count + estimate').first().json;\nconst done = new Set($('Processed IDs').all().map(r => r.json).filter(r => r.source === 'gmail').map(r => r.messageId));\nconst ids = [...new Set($('Gmail: list IDs').all().flatMap(p => (p.json.messages || []).map(m => m.id)))]\n  .filter(id => !done.has(id));\nreturn ids.slice(0, c.gmailThisRun).map(id => ({ json: { id } }));\n",
