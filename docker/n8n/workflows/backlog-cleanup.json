      "parameters": {
        "jsCode": "// Run report: counts per mailbox and category, plus the mails worth a look\nconst today = $now.toFormat('yyyy-MM-dd');\nconst results = [];\ntry { results.push(...$('Loop Gmail').all(0).map(i => i.json)); } catch (e) {}\nresults.push(...$input.all().map(i => i.json));\n\nconst perSourceCategory = {};\nfor (const r of results) {\n  const key = `${r.source}/${r.aiError ? 'ai_error' : r.category}`;\n  perSourceCategory[key] = (perSourceCategory[key] || 0) + 1;\n}\nconst pick = r => ({ source: r.source, from: r.from, subject: r.subject, category: r.category, amount: r.amount, due_date: r.due_date, suspicious: r.suspicious, confidence: r.confidence, reason: r.reason });\n\nreturn [{ json: {\n  processed: results.length,\n  perSourceCategory,\n  remindersCreated: results.filter(r => !r.aiError && r.category === 'payment_due' && r.remindDate && (r.due_date || '') >= today).length,\n  payments: results.filter(r => r.category === 'payment_due').map(pick),\n  toCheck: results.filter(r => r.category === 'check' && !r.aiError).map(pick),\n  aiErrors: results.filter(r => r.aiError).map(pick),\n} }];\n",
