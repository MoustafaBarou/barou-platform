    {
      "id": "00e602d2-0aee-4b64-bf26-ebd9514a265b",
      "name": "Outlook: check get",
      "parameters": {
        "jsCode": "// Graph throttling: if any request in this batch got 429/503/504, wait max(Retry-After, 60 s) and fetch the whole batch again\nconst RETRYABLE = [429, 503, 504];\nconst MAX_RETRIES = 5;\nconst sent = $('Outlook: to fetch').all().map(i => i.json);\nconst res = $input.all().map(i => i.json);\n\nconst throttled = res.filter(r => RETRYABLE.includes(r.statusCode));\nif (throttled.length) {\n  const attempt = Math.max(...sent.map(s => s.attempt || 0)) + 1;\n  if (attempt > MAX_RETRIES) throw new Error(`Graph still throttling after ${MAX_RETRIES} retries (HTTP ${throttled[0].statusCode})`);\n  const retryAfter = Math.max(60, ...throttled.map(r => Number(r.headers?.['retry-after']) || 0));\n  return sent.map(s => ({ json: { id: s.id, attempt, retryAfter, throttled: true } }));\n}\n\nconst failed = res.find(r => r.statusCode >= 400);\nif (failed) throw new Error(`Outlook: get message failed with HTTP ${failed.statusCode}: ${JSON.stringify(failed.body?.error ?? failed.body).slice(0, 300)}`);\nreturn res.map(r => ({ json: r.body }));\n",
        "mode": "runOnceForAllItems"
