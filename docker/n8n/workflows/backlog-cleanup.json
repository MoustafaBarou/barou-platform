    {
      "id": "70bf3fd3-6844-4fc0-859e-2a763fad574c",
      "name": "Count + estimate",
      "parameters": {
        "jsCode": "// Count the backlog per mailbox and estimate the Claude cost before anything is labeled\nconst s = $('Settings').first().json;\nconst COST_PER_MAIL_USD = 0.00030; // trial #52: ~2,380 input x $0.10/M + ~125 output x $0.50/M\nconst SECONDS_PER_MAIL = 1.6;      // trial #52: 100 mails in 156 s\n\n// Mails already in processed_mails are skipped\nconst rows = $('Processed IDs').all().map(r => r.json).filter(r => r.messageId);\nconst done = src => new Set(rows.filter(r => r.source === src).map(r => r.messageId));\nconst gmailDone = done('gmail');\nconst outlookDone = done('outlook');\n\nconst gmailIds = [...new Set($('Gmail: list IDs').all().flatMap(p => (p.json.messages || []).map(m => m.id)))];\nconst outlookAll = $('Outlook: list IDs').all().flatMap(p => p.json.value || []);\nconst outlookIds = outlookAll.filter(m => !(m.categories || []).length).map(m => m.id);\nconst gmailTodo = gmailIds.filter(id => !gmailDone.has(id));\nconst outlookTodo = outlookIds.filter(id => !outlookDone.has(id));\n\nconst take = n => (s.LIMIT > 0 ? Math.min(n, s.LIMIT) : n);\nconst gmailThisRun = s.COUNT_ONLY ? 0 : take(gmailTodo.length);\nconst outlookThisRun = s.COUNT_ONLY ? 0 : take(outlookTodo.length);\nconst total = gmailTodo.length + outlookTodo.length;\nconst round = x => Math.round(x * 1000) / 1000;\n\nreturn [{ json: {\n  since: s.SINCE,\n  gmailFound: gmailIds.length,\n  gmailAlreadyProcessed: gmailIds.length - gmailTodo.length,\n  gmailRemaining: gmailTodo.length,\n  outlookInFolder: outlookAll.length,\n  outlookSkippedCategorized: outlookAll.length - outlookIds.length,\n  outlookAlreadyProcessed: outlookIds.length - outlookTodo.length,\n  outlookRemaining: outlookTodo.length,\n  totalRemaining: total,\n  estimatedCostUsdRemaining: round(total * COST_PER_MAIL_USD),\n  estimatedMinutesRemaining: Math.ceil(total * SECONDS_PER_MAIL / 60),\n  limit: s.LIMIT,\n  countOnly: s.COUNT_ONLY,\n  gmailThisRun,\n  outlookThisRun,\n  estimatedCostUsdThisRun: round((gmailThisRun + outlookThisRun) * COST_PER_MAIL_USD),\n  estimatedMinutesThisRun: Math.ceil((gmailThisRun + outlookThisRun) * SECONDS_PER_MAIL / 60),\n} }];\n",
        "mode": "runOnceForAllItems"
      },
