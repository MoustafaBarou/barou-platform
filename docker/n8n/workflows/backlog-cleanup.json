      "name": "Outlook: check set",
      "parameters": {
        "jsCode": "// Graph throttling: retry only the throttled PATCHes after max(Retry-After, 60 s); other errors stop the run\nconst RETRYABLE = [429, 503, 504];\nconst MAX_RETRIES = 5;\nconst sent = $('Outlook: mails to categorize').all().map(i => i.json);\n\nconst retry = [];\n$input.all().forEach((i, k) => {\n  const r = i.json;\n  if (RETRYABLE.includes(r.statusCode)) {\n    retry.push({ ...sent[k], attempt: (sent[k].attempt || 0) + 1, retryAfter: Number(r.headers?.['retry-after']) || 0 });\n  } else if (r.statusCode >= 400) {\n    throw new Error(`Outlook: set category failed with HTTP ${r.statusCode}: ${JSON.stringify(r.body?.error ?? r.body).slice(0, 300)}`);\n  }\n});\nif (retry.some(r => r.attempt > MAX_RETRIES)) throw new Error(`Graph still throttling after ${MAX_RETRIES} retries (set category)`);\n\nconst retryAfter = Math.max(60, ...retry.map(r => r.retryAfter));\nreturn retry.map(r => ({ json: { ...r, retryAfter } }));\n",
