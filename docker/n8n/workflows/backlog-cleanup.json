    {
      "id": "b1b1539d-771d-473a-b0f5-7aa276c21d36",
      "name": "Gmail: payments due today or later",
      "parameters": {
        "jsCode": "// Calendar reminder only when the due date is today or later; old invoices get the label only\nconst today = $now.toFormat('yyyy-MM-dd');\nreturn $input.all()\n  .filter(i => !i.json.aiError && i.json.category === 'payment_due' && i.json.remindDate\n    && /^\\d{4}-\\d{2}-\\d{2}$/.test(i.json.due_date || '') && i.json.due_date >= today)\n  .map(i => {\n    const start = new Date(i.json.remindDate);\n    const end = new Date(start.getTime() + 30 * 60000);\n    return {\n      json: {\n        ...i.json,\n        calendarEvent: {\n          summary: `💶 Betalen: ${i.json.subject}`,\n          description: `Bedrag: ${i.json.amount ?? 'onbekend'}\\nVervaldatum: ${i.json.due_date}\\nVan: ${i.json.from}\\nMailbox: ${i.json.source}`,\n          start: { dateTime: start.toISOString() },\n          end: { dateTime: end.toISOString() },\n          reminders: { useDefault: true },\n        },\n      },\n    };\n  });\n",
        "mode": "runOnceForAllItems"
