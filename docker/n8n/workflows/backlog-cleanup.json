      "name": "Gmail: attach label IDs",
      "parameters": {
        "jsCode": "// Only mails with a label; Claude errors are skipped so a next run retries them\nconst labels = $('Gmail: get labels').first().json.labels || [];\nconst byName = Object.fromEntries(labels.map(l => [l.name.toLowerCase(), l.id]));\n\nreturn $input.all()\n  .filter(i => !i.json.aiError && i.json.label)\n  .map(i => {\n    const id = byName[i.json.label.toLowerCase()];\n    if (!id) throw new Error(`Gmail label \"${i.json.label}\" not found. Create it in Gmail first.`);\n    const addLabelIds = [id];\n    if (i.json.category === 'payment_due') addLabelIds.push('STARRED');\n    return { json: { ...i.json, addLabelIds } };\n  });\n",
        "mode": "runOnceForAllItems"
      },
