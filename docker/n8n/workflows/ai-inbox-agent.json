    {
      "id": "f423e75b-8a83-4783-9f4c-9d1d5c66bc71",
      "name": "Payments with due date",
      "parameters": {
        "jsCode": "// Only payments with a due date -> calendar reminder\nreturn $input.all()\n  .filter(i => i.json.category === 'payment_due' && i.json.remindDate)\n  .map(i => {\n    const start = new Date(i.json.remindDate);\n    const end = new Date(start.getTime() + 30 * 60000);\n    return {\n      json: {\n        ...i.json,\n        calendarEvent: {\n          summary: `💶 Betalen: ${i.json.subject}`,\n          description: `Bedrag: ${i.json.amount ?? 'onbekend'}\\nVervaldatum: ${i.json.due_date}\\nVan: ${i.json.from}\\nMailbox: ${i.json.source}`,\n          start: { dateTime: start.toISOString() },\n          end: { dateTime: end.toISOString() },\n          reminders: { useDefault: true },\n        },\n      },\n    };\n  });\n"
      },
