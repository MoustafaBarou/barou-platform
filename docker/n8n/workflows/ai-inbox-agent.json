        "jsCode": "// Log classified mails to processed_mails (Backlog cleanup skips these); Claude errors are not logged\nreturn $input.all()\n  .filter(i => !i.json.aiError)\n  .map(i => ({ json: {\n    source: i.json.source,\n    messageId: i.json.messageId,\n    category: i.json.category,\n    confidence: Number(i.json.confidence) || 0,\n    reason: i.json.reason || '',\n    processedAt: $now.toISO(),\n  } }));\n",
