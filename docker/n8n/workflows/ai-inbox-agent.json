    {
      "id": "cbe071d8-d449-4d6e-9582-2ab9eb9a7229",
      "name": "Attach label IDs",
      "parameters": {
        "jsCode": "// Map label names to Gmail label IDs\nconst labels = $input.first().json.labels || [];\nconst byName = Object.fromEntries(labels.map(l => [l.name.toLowerCase(), l.id]));\n\nreturn $('Gmail items').all().map(i => {\n  const id = byName[i.json.label.toLowerCase()];\n  if (!id) throw new Error(`Gmail label \"${i.json.label}\" not found. Create it in Gmail first.`);\n  const addLabelIds = [id];\n  if (i.json.category === 'payment_due') addLabelIds.push('STARRED');\n  return { json: { ...i.json, addLabelIds } };\n});\n"
      },
      "position": [
        1504,
        240
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
