# Copy to .env and fill in real values. Never commit .env.

# Encrypts stored credentials. Generate once with: openssl rand -hex 32
# Keep it safe: losing it makes all saved credentials unreadable.
N8N_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# Public base URL of n8n (used for webhooks and OAuth redirect URLs),
# passed to the container as N8N_WEBHOOK_URL. Include the trailing slash.
WEBHOOK_URL=https://<your-host>/

# n8n public API, used by n8n-mcp (Claude Code). Base URL without /api/v1.
# Create the key in n8n under Settings > n8n API.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=<n8n-api-key>
