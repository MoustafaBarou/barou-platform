# Temporary backup files
*.bak

# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files may contain sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform backend configuration may contain sensitive values
*.tfbackend
!*.tfbackend.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local Azure CLI configuration
.azure/
